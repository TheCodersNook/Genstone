          "fileName": "structs.h",
          "template": "#ifndef EEZ_LVGL_UI_STRUCTS_H\n#define EEZ_LVGL_UI_STRUCTS_H\n\n//${eez-studio EEZ_FOR_LVGL_CHECK}\n\n#if defined(EEZ_FOR_LVGL)\n\n#include <eez/flow/flow.h>\n#include <stdint.h>\n#include <stdbool.h>\n\n#include \"vars.h\"\n\nusing namespace eez;\n\n//${eez-studio FLOW_STRUCTS}\n\n//${eez-studio FLOW_STRUCT_VALUES}\n\n#endif\n\n#endif /*EEZ_LVGL_UI_STRUCTS_H*/\n"
        },
        {
          "objID": "3fa83764-3101-4152-a897-b5a916d7a369",
          "fileName": "images.h",
          "template": "#ifndef EEZ_LVGL_UI_IMAGES_H\r\n#define EEZ_LVGL_UI_IMAGES_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_IMAGES_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_IMAGES_H*/"
        },
        {
          "objID": "a482d01b-836c-4348-f677-325c233cba18",
          "fileName": "images.c",
          "template": "#include \"images.h\"\n\n//${eez-studio LVGL_IMAGES_DEF}"
        },
        {
          "objID": "f58a24a4-88cc-4774-92d7-29f7da3a7293",
          "fileName": "fonts.h",
          "template": "#ifndef EEZ_LVGL_UI_FONTS_H\r\n#define EEZ_LVGL_UI_FONTS_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_FONTS_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_FONTS_H*/"
        },
        {
          "objID": "bfa49c1f-5700-42fd-9032-45635afdbe2e",
          "fileName": "styles.h",
          "template": "#ifndef EEZ_LVGL_UI_STYLES_H\r\n#define EEZ_LVGL_UI_STYLES_H\r\n\r\n//${eez-studio LVGL_INCLUDE}\r\n\r\n#ifdef __cplusplus\r\nextern \"C\" {\r\n#endif\r\n\r\n//${eez-studio LVGL_STYLES_DECL}\r\n\r\n#ifdef __cplusplus\r\n}\r\n#endif\r\n\r\n#endif /*EEZ_LVGL_UI_STYLES_H*/"
        },
        {
          "objID": "0c634e3b-b2f5-4f27-8c20-6bf76a2967d3",
          "fileName": "styles.c",
          "template": "#include \"styles.h\"\n#include \"images.h\"\n#include \"fonts.h\"\n\n//${eez-studio LVGL_STYLES_DEF}\n"
        },
        {
          "objID": "53be9483-f0d9-4c4d-c816-b29544f634d2",
          "fileName": "ui.h",
          "template": "#ifndef EEZ_LVGL_UI_GUI_H\n#define EEZ_LVGL_UI_GUI_H\n\n//${eez-studio LVGL_INCLUDE}\n\n//${eez-studio EEZ_FOR_LVGL_CHECK}\n\n#if defined(EEZ_FOR_LVGL)\n#include <eez/flow/lvgl_api.h>\n#endif\n\n#if !defined(EEZ_FOR_LVGL)\n#include \"screens.h\"\n#endif\n\n#ifdef __cplusplus\nextern \"C\" {\n#endif\n\n//${eez-studio GUI_ASSETS_DECL}\n\nvoid ui_init();\nvoid ui_tick();\n\n#if !defined(EEZ_FOR_LVGL)\nvoid loadScreen(enum ScreensEnum screenId);\n#endif\n\n#ifdef __cplusplus\n}\n#endif\n\n#endif // EEZ_LVGL_UI_GUI_H"
        },
        {
          "objID": "893136b2-a28c-4e17-a17e-1191fb4e33e7",
          "fileName": "ui.c",
          "template": "#if defined(EEZ_FOR_LVGL)\n#include <eez/core/vars.h>\n#endif\n\n#include \"ui.h\"\n#include \"screens.h\"\n#include \"images.h\"\n#include \"actions.h\"\n#include \"vars.h\"\n#include <string.h>\n//${eez-studio GUI_ASSETS_DEF}\n\n//${eez-studio LVGL_NATIVE_VARS_TABLE_DEF}\n\n//${eez-studio LVGL_ACTIONS_ARRAY_DEF}\n\n#if defined(EEZ_FOR_LVGL)\n\nvoid ui_init() {\n    eez_flow_init(assets, sizeof(assets), (lv_obj_t **)&objects, sizeof(objects), images, sizeof(images), actions);\n}\n\nvoid ui_tick() {\n    eez_flow_tick();\n    tick_screen(g_currentScreen);\n}\n\n#else\n\nstatic int16_t currentScreen = -1;\n\nstatic lv_obj_t *getLvglObjectFromIndex(int32_t index) {\n    if (index == -1) {\n        return 0;\n    }\n    return ((lv_obj_t **)&objects)[index];\n}\n\nstatic const void *getLvglImageByName(const char *name) {\n    for (size_t imageIndex = 0; imageIndex < sizeof(images) / sizeof(ext_img_desc_t); imageIndex++) {\n        if (strcmp(images[imageIndex].name, name) == 0) {\n            return images[imageIndex].img_dsc;\n        }\n    }\n    return 0;\n}\n\nvoid loadScreen(enum ScreensEnum screenId) {\n    currentScreen = screenId - 1;\n    lv_obj_t *screen = getLvglObjectFromIndex(currentScreen);\n    lv_scr_load_anim(screen, LV_SCR_LOAD_ANIM_FADE_IN, 200, 0, false);\n}\n\nvoid ui_init() {\n    create_screens();\n    //${eez-studio LVGL_LOAD_FIRST_SCREEN}\n}\n\nvoid ui_tick() {\n    tick_screen(currentScreen);\n}\n\n#endif\n"
        },
        {
          "objID": "c410b3b0-08e4-4f94-dcc9-66bd41193ace",
          "fileName": "actions.c",
          "template": "#include \"actions.h\"\n#include \"screens.h\"\n#include \"ui.h\"\n#include <string.h>\n\nstatic char pin_buffer[5] = \"\";\nstatic int pin_len = 0;\n\nstatic const int screen_order[] = {\n    SCREEN_ID_TODOS,\n    SCREEN_ID_CALENDAR,\n    SCREEN_ID_NOTES,\n    SCREEN_ID_RECORD,\n    SCREEN_ID_SUMMARY,\n};\nstatic const int screen_count = sizeof(screen_order) / sizeof(screen_order[0]);\nstatic int current_screen_idx = 0;\nstatic int return_to_idx = -1;\nstatic int in_settings_shade = 0;\n\nstatic void update_pin_dots(void) {\n    lv_obj_t *dots[4] = {objects.dot1, objects.dot2, objects.dot3, objects.dot4};\n    for (int i = 0; i < 4; i++) {\n        if (i < pin_len) {\n            lv_obj_set_style_bg_color(dots[i], lv_color_hex(0x000000), LV_PART_MAIN);\n            lv_obj_set_style_bg_opa(dots[i], LV_OPA_COVER, LV_PART_MAIN);\n        } else {\n            lv_obj_set_style_bg_opa(dots[i], LV_OPA_TRANSP, LV_PART_MAIN);\n        }\n    }\n}\n\nvoid action_on_pin_key(lv_event_t *e) {\n    lv_obj_t *bm = lv_event_get_target(e);\n    uint16_t id = lv_btnmatrix_get_selected_btn(bm);\n    if (id == LV_BTNMATRIX_BTN_NONE) return;\n    const char *txt = lv_btnmatrix_get_btn_text(bm, id);\n    if (!txt || txt[0] < '0' || txt[0] > '9') return;\n    if (pin_len >= 4) return;\n    pin_buffer[pin_len++] = txt[0];\n    pin_buffer[pin_len] = '\\0';\n    update_pin_dots();\n    if (pin_len == 4) {\n        if (strcmp(pin_buffer, \"1234\") == 0) {\n            current_screen_idx = 0;\n            return_to_idx = -1;\n            in_settings_shade = 0;\n            loadScreen(SCREEN_ID_TODOS);\n        }\n        pin_len = 0;\n        pin_buffer[0] = '\\0';\n        update_pin_dots();\n    }\n}\n\nvoid action_sleep_pressed(lv_event_t *e) {\n    loadScreen(SCREEN_ID_SLEEP);\n}\n\nvoid action_wake_up(lv_event_t *e) {\n    pin_buffer[0] = '\\0';\n    pin_len = 0;\n    update_pin_dots();\n    loadScreen(SCREEN_ID_MAIN);\n}\n\nvoid action_go_to_wifi(lv_event_t *e) {\n    loadScreen(SCREEN_ID_WI_FI);\n}\n\nvoid action_wifi_settings(lv_event_t *e) {\n    loadScreen(SCREEN_ID_WI_FI);\n}\n\nvoid action_back_to_settings(lv_event_t *e) {\n    loadScreen(SCREEN_ID_SETTINGS);\n}\n\nvoid action_go_to_settings(lv_event_t *e) {\n    loadScreen(SCREEN_ID_SETTINGS);\n}\n\nvoid action_swipe_nav(lv_event_t *e) {\n    lv_indev_t *indev = lv_indev_get_act();\n    lv_dir_t dir = lv_indev_get_gesture_dir(indev);\n    if (dir == LV_DIR_LEFT || dir == LV_DIR_RIGHT) {\n        if (in_settings_shade) {\n            current_screen_idx = return_to_idx;\n            in_settings_shade = 0;\n            return_to_idx = -1;\n        }\n        if (dir == LV_DIR_LEFT) {\n            current_screen_idx = (current_screen_idx + 1) % screen_count;\n        } else {\n            current_screen_idx = (current_screen_idx - 1 + screen_count) % screen_count;\n        }\n        loadScreen(screen_order[current_screen_idx]);\n    }\n    else if (dir == LV_DIR_BOTTOM) {\n        if (!in_settings_shade) {\n            return_to_idx = current_screen_idx;\n            in_settings_shade = 1;\n            loadScreen(SCREEN_ID_SETTINGS);\n        }\n    }\n    else if (dir == LV_DIR_TOP) {\n        if (in_settings_shade) {\n            current_screen_idx = return_to_idx;\n            in_settings_shade = 0;\n            return_to_idx = -1;\n            loadScreen(screen_order[current_screen_idx]);\n        }\n    }\n}\n"
        }
      ],
      "destinationFolder": "src\\ui",
      "separateFolderForImagesAndFonts": false,
      "imageExportMode": "source",
      "fontExportMode": "source",
      "fileSystemPath": "",
